<?xml version="1.0" ?>
<!--
  Etapa II — Subcenario GNRON (Goal Non-Reachable with Obstacles Nearby)
  Partida: S = (0.0, 0.0, 0.0) | Meta: T = (6.0, 0.0)
  Parede posicionada a 0.45 m ATRAS da meta (face frontal em x = 6.45 m < rho_0).
-->
<sdf version="1.9">
  <world name="cenario_gnron">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Chao -->
    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.84 0.84 0.84 1</ambient><diffuse>0.86 0.86 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Marcador visual da Meta T = (6.0, 0.0) (sem colisao!) -->
    <model name="meta_visual">
      <static>true</static>
      <link name="link">
        <pose>6.0 0.0 0.005 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.18</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.95 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Parede atras da meta (centro em x = 6.55 m, espessura 0.20 m -> face frontal em 6.45 m) -->
    <model name="parede_gnron">
      <static>true</static>
      <link name="parede">
        <pose>6.55 0.0 0.45 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.20 2.2 0.9</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.20 2.2 0.9</size></box></geometry>
          <material><ambient>0.55 0.40 0.15 1</ambient><diffuse>0.70 0.50 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Robo diferencial na partida S = (0, 0, 0) -->
    <include>
      <uri>model://robo_diferencial</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
