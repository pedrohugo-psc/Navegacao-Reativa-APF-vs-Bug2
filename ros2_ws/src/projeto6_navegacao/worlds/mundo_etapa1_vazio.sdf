<?xml version="1.0" ?>
<!--
  Mundo de Teste da Fase 3 e Etapa I (mundo_etapa1_vazio.sdf)
  Contem espaco amplo livre para as 3 trajetorias da Etapa I e paredes externas
  afastadas (x em [-4, 12], y em [-6, 6]) para o LiDAR medir distancias reais.
-->
<sdf version="1.9">
  <world name="mundo_etapa1_vazio">
    <!-- Motor de fisica a 1 kHz (passo de 1 ms) -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins globais obrigatorios do Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Iluminacao solar -->
    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Plano do chao -->
    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="colisao">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.82 0.82 0.82 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Paredes distantes da arena (16 m x 12 m) para o LiDAR retornar leituras finitas -->
    <model name="arena_paredes">
      <static>true</static>
      <link name="parede_frente">
        <pose>12.0 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 12.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 12.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
      <link name="parede_tras">
        <pose>-4.0 0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 12.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 12.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
      <link name="parede_esquerda">
        <pose>4.0 6.0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>16.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
      <link name="parede_direita">
        <pose>4.0 -6.0 0.5 0 0 0</pose>
        <collision name="c"><geometry><box><size>16.2 0.2 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>16.2 0.2 1.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Inclusao modular do nosso robo diferencial na origem (0, 0, 0) -->
    <include>
      <uri>model://robo_diferencial</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
