<?xml version="1.0" ?>
<!--
  Etapa II — Cenario A: Obstaculos Esparsos e Corredor (cenario_a_esparsos.sdf)
  Partida: S = (0.0, 0.0, 0.0) | Meta: T = (8.0, 0.0)
  Valida desvio suave em obstaculos convexos e passagem por corredor.
-->
<sdf version="1.9">
  <world name="cenario_a_esparsos">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Chao -->
    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.84 0.84 0.84 1</ambient><diffuse>0.86 0.86 0.86 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Marcador visual da Meta T = (8.0, 0.0) (sem colisao!) -->
    <model name="meta_visual">
      <static>true</static>
      <link name="link">
        <pose>8.0 0.0 0.005 0 0 0</pose>
        <visual name="v">
          <geometry><cylinder><radius>0.18</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.95 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstaculos do Cenario A (mesma geometria validada na Fase 2!) -->
    <model name="obstaculos_cenario_a">
      <static>true</static>

      <!-- Caixa 1 -->
      <link name="caixa_1">
        <pose>2.2 0.35 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.35 0.45 0.52 1</ambient><diffuse>0.40 0.52 0.60 1</diffuse></material>
        </visual>
      </link>

      <!-- Cilindro intermediario -->
      <link name="cilindro_1">
        <pose>3.3 -0.25 0.4 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.65 0.40 0.20 1</ambient><diffuse>0.75 0.48 0.25 1</diffuse></material>
        </visual>
      </link>

      <!-- Caixa 2 -->
      <link name="caixa_2">
        <pose>4.3 -0.50 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.8 0.8 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.8</size></box></geometry>
          <material><ambient>0.35 0.45 0.52 1</ambient><diffuse>0.40 0.52 0.60 1</diffuse></material>
        </visual>
      </link>

      <!-- Corredor (parede superior e parede inferior em x = 6.0) -->
      <link name="corredor_sup">
        <pose>6.0 1.05 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.4 0.5 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.4 0.5 0.8</size></box></geometry>
          <material><ambient>0.30 0.35 0.40 1</ambient><diffuse>0.35 0.42 0.48 1</diffuse></material>
        </visual>
      </link>
      <link name="corredor_inf">
        <pose>6.0 -1.05 0.4 0 0 0</pose>
        <collision name="c"><geometry><box><size>1.4 0.5 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.4 0.5 0.8</size></box></geometry>
          <material><ambient>0.30 0.35 0.40 1</ambient><diffuse>0.35 0.42 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Robo diferencial na partida S = (0, 0, 0) -->
    <include>
      <uri>model://robo_diferencial</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
